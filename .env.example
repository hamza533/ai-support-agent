# Copy to .env and fill in. Never commit .env. All settings use ASP.NET Core's __ separator.
# Values here are SAFE PLACEHOLDERS for local docker compose only.

# --- Postgres (local docker compose) ---
POSTGRES_USER=brightline
POSTGRES_PASSWORD=brightline-dev-only
# Host port for connecting tools (psql, IDE) to the compose Postgres
POSTGRES_HOST_PORT=55432
# App DB connection (the web app). Neon in demo, Azure PostgreSQL Flexible Server in production.
ConnectionStrings__App=Host=postgres;Database=brightline_app;Username=brightline;Password=brightline-dev-only
# Legacy DB connection: used ONLY by the Brightline.LegacyOrders API, never by the web app.
ConnectionStrings__LegacyOrders=Host=postgres;Database=brightline_legacy;Username=brightline;Password=brightline-dev-only

# --- AI provider ---
# gemini-openai-compat (dev/demo, free tier) | azure-openai (production) | openai
Ai__Provider=gemini-openai-compat
Ai__ChatModel=gemini-3.5-flash-lite
Ai__EmbeddingModel=gemini-embedding-001
# Must match the pgvector column dimension (vector(768)).
Ai__EmbeddingDimensions=768
# Get a free key at https://aistudio.google.com/apikey
Ai__Gemini__ApiKey=
Ai__Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/openai/
# Azure OpenAI (production): endpoint only, auth via managed identity / DefaultAzureCredential.
# https://portal.azure.com -> Azure OpenAI resource -> Keys and Endpoint
Ai__AzureOpenAI__Endpoint=
# Plain OpenAI (optional): https://platform.openai.com/api-keys
Ai__OpenAI__ApiKey=

# --- Legacy Orders API (typed client in the web app; key check in the legacy API) ---
LegacyOrders__BaseUrl=http://legacy-api:8080
LegacyOrders__ApiKey=dev-legacy-api-key-change-me
LegacyOrders__AdminKey=dev-legacy-admin-key-change-me

# --- Staff sign-in ---
Auth__EntraId__Enabled=false
# Entra ID app registration: https://entra.microsoft.com -> App registrations
Auth__EntraId__TenantId=
Auth__EntraId__ClientId=

# --- Demo mode ---
Demo__Enabled=false
Demo__DailyConversations=40

# --- Rate limiting ---
RateLimit__ChatPerMinute=20

# --- Background worker: embedded (in web process) | separate | disabled ---
Worker__Mode=embedded

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
# Production only (Azure Portal -> Application Insights -> Connection string)
APPLICATIONINSIGHTS_CONNECTION_STRING=

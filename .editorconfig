root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,bicep,razor.css,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0161.severity = warning
# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
# Analyzer tuning (documented in docs/DECISIONS.md)
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source-gen not required for app code
dotnet_diagnostic.CA2007.severity = none   # No ConfigureAwait in ASP.NET Core apps
dotnet_diagnostic.CA1515.severity = none   # Types are public for tests across assemblies
dotnet_diagnostic.CA1707.severity = none   # Underscores allowed in test names

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

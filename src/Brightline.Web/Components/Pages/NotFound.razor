@page "/not-found"
@layout AuthLayout

<PageTitle>Not found · Brightline</PageTitle>

<Card Class="auth-card">
    <CardHeader>
        <CardTitle><h1 style="font-size:20px">Page not found</h1></CardTitle>
        <CardDescription>The page you were looking for doesn't exist.</CardDescription>
    </CardHeader>
    <CardFooter>
        <LinkButton Href="/" Variant="ButtonVariant.Outline">Back to the Help Center</LinkButton>
    </CardFooter>
</Card>
